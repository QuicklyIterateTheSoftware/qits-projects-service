<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- THE PROVIDER'S GOLDEN MASTERS AS A JAR, and nothing else (epic qits-546). It holds no code: it
         packages the repository-root `golden-masters/` tree — index.json plus one JSON per (state,
         operation), written by service's GoldenMasterRecordingTest — as classpath resources UNDER
         `golden-masters/`, so a consumer's pact test reads `golden-masters/index.json` off its test
         classpath.

         NO PARENT, ON PURPOSE. The reactor root `qits-projects` is never published (this repository
         ships an image, not a library), so a published pom naming it as parent would resolve to
         nothing for every consumer. Standalone, the deployed pom is this file verbatim and depends
         on nothing. It is still a <module> of the root reactor, because the release commit's
         version bump (ManifestVersionBump) walks the reactor by <module> and rewrites every pom's
         own <version> — so this one moves with the release like the others.

         THE TREE LIVES OUTSIDE THIS DIRECTORY so the published tree holds no build files: no pom,
         no target/. The same `golden-masters/` directory is what the `@contracts/qits-projects`
         docs bundle carries and what slice two packs as an npm tarball, so nothing maven-shaped
         may sit inside it.

         Released by the second step of `.config/qits/release.yml`, and only when the tree differs
         from the newest published jar's (`.config/qits/published-tree-changed.sh`). -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-projects-golden-masters</artifactId>
    <version>2026.1001.222342</version>
    <packaging>jar</packaging>
    <name>qits-projects :: golden-masters</name>
    <description>qits-projects provider golden masters (golden-masters/index.json and one JSON per provider state and operation)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Fixed, so two builds of one tree produce the same jar bytes. The change gate compares
             tree contents, not jar bytes, so this is hygiene rather than the mechanism. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <jar-plugin.version>3.4.2</jar-plugin.version>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/../golden-masters</directory>
                <targetPath>golden-masters</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <!-- No META-INF/maven/**: the jar is the tree plus a manifest. -->
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
