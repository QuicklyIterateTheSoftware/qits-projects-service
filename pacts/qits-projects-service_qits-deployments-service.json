      "providerStates": [
        {
          "name": "an application deployed in an environment",
          "params": {
            "applicationName": "contract-app-00000001",
            "environmentId": "00000000-0000-4000-8000-000000000001",
            "repoId": "contract-app-00000001",
            "version": "2026.101.120000"
          }
        }
      ],
      "request": {
        "generators": {
          "query": {
            "repoId": {
